# Environment Configuration Template for LocalCompute Commons
APP_NAME="LocalCompute Commons"
ENVIRONMENT="production"
DEBUG=false

# Coordinator Binding
COORDINATOR_HOST="0.0.0.0"
COORDINATOR_PORT=8000

# Database
DATABASE_URL="postgresql+asyncpg://lc_user:lc_secure_password_2026@postgres:5432/localcompute"

# Redis Queue
REDIS_URL="redis://redis:6379/0"
USE_IN_MEMORY_QUEUE=false

# Security & Secrets (Generate strong random secrets for production)
SECRET_KEY="generate-a-strong-random-64-character-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Admin Credentials
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_EMAIL="admin@localcompute.local"
DEFAULT_ADMIN_PASSWORD="ChangeMeAdmin2026!"

# Inference
OLLAMA_BASE_URL="http://localhost:11434"
MOCK_INFERENCE=false
